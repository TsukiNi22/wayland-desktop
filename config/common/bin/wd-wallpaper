#!/usr/bin/env python3
# Usage: wd-wallpaper [page.html] [--demo] | --cache | --lock | --pam | --radio <command>
#   (no page: the wallpaper.html of the active style; --demo: fake music, to try a page)
#   --cache: download the offline tracks of the radios (radio.json of the styles), then quit
#   --lock: the live wallpaper of this session locks it (wd-style lock), back once unlocked: 0 unlocked, 1 can't lock
#           (no live wallpaper, no gtk-session-lock or libpam), 2 died or failed while locked (hyprlock takes it back)
#   --pam: checks the password given on stdin with PAM (0: right), a process of its own for each try of the lock
#   --radio: the tracks of a radio (wd-style radio): list [style] | add <style> <url|mp3|search> [title [subtitle]]
#            | remove <style> <index> | offline <style> <index|all> [on|off] | folder <style> | show | hide | toggle
#   SIGHUP: crossfade to the page of the new active style (sent by wd-style), SIGTERM / SIGINT: quit
#   (never SIGUSR1: WebKit suspends its threads with it, catching it freezes the process)
#   WD_RADIO_ARGS: more mpv arguments for the radio (ex: --volume=50)
# Live wallpaper of wayland-desktop: a web page on the background layer of every monitor (GTK 3, gtk-layer-shell,
# WebKit 4.1), fed 30 times a second with the music levels of cava (wdAudio(levels) in the page, see wd.js)
# A new page fades in over the still wallpaper (swaybg) or the previous page, then removes it; the clicks go through
# the wallpaper except on the parts the page declares (its radio). The radio of a style is its folder,
# ~/Music/wd-radio/<style>: its .mp3 files, and online.md for the tracks played from YouTube (made from the radio.json of
# the style, made again when deleted); anything else put there goes to its ignored/ folder (never deleted). Changes of
# the folder reach the pages and the playing list at once. Some online tracks are kept offline in ~/.local/share/wd-radio
# (downloaded once with yt-dlp, a personal copy); the player loops a track, opens the folder and saves a track as an mp3
# where the user says; the media of the pages (the video of the Miku beam, the concert clips of the Ado stage) are parts
# of official videos cut and joined once with ffmpeg in ~/.local/share/wd-radio/media, a personal copy
# The lock of the session is the wallpaper itself: the lock surfaces (gtk-session-lock) get a live page of the style
# (fed like the wallpaper: music, radio), which draws its lock over itself; PAM checks the password like hyprlock does
import ctypes
import ctypes.util
import fcntl
import functools
import glob
import re
import hashlib
import json
import os
import platform
import pwd
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path
from urllib.parse import urlencode

# GTK, WebKit and cairo only for the wallpaper itself (wd-style radio and --cache start at once without them)
cairo = Gdk = Gio = GLib = GLibUnix = Gtk = GtkLayerShell = GtkSessionLock = WebKit2 = None

def load_gui():
    global cairo, Gdk, Gio, GLib, GLibUnix, Gtk, GtkLayerShell, GtkSessionLock, WebKit2
    import cairo
    import gi

    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    gi.require_version("WebKit2", "4.1")
    gi.require_version("GLibUnix", "2.0")
    from gi.repository import Gdk, Gio, GLib, GLibUnix, Gtk, GtkLayerShell, WebKit2
    # the lock of the session (none without it: hyprlock locks)
    try:
        gi.require_version("GtkSessionLock", "0.1")
        from gi.repository import GtkSessionLock
    except (ValueError, ImportError):
        GtkSessionLock = None

DATA_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "wayland-desktop"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
CACHE_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")) / "wd-radio"
# the user's choices: the tracks kept offline or saved (offline.json), the radios shown (shown.json), the loop
USER_RADIO_DIR = DATA_DIR / "radio"
# in the folder of a radio: the online tracks, the folder of what is not a track
ONLINE_FILE = "online.md"
IGNORED_DIR = "ignored"
# tracks being downloaded by the button of the player
DOWNLOADING = set()
# the user's own emotes (png, gif, webp, jpg, svg), used by the pages that show emotes (the Ado chat)
EMOTES_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")) / "wd-emotes"
BARS = 48
CAVA_CONFIG = f"""[general]
framerate = 30
bars = {BARS}
sleep_timer = 2

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
monstercat = 0
noise_reduction = 60
"""

# =========================
# Page
# =========================
def page_uri(page, demo):
    if page is None:
        style = (DATA_DIR / "current").read_text().strip()
        page = DATA_DIR / "styles" / style / "wallpaper.html"
    query = urlencode({"user": os.environ.get("USER", "user"), "host": socket.gethostname().split(".")[0],
                       "os": os_name(), "kernel": platform.release(), "shell": Path(os.environ.get("SHELL", "sh")).name,
                       "radio": int(Radio.available())})
    return Path(page).resolve().as_uri() + "?" + query + ("&demo" if demo else "")

def os_name():
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip('"')
    except OSError:
        pass
    return platform.system()

def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "wd-style", title, body])

# =========================
# Radio
# =========================
def read_json(path, default):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default

# the folder of a radio: ~/Music/wd-radio/<style> (the music folder of the user's language)
@functools.cache
def music_dir():
    try:
        path = subprocess.run(["xdg-user-dir", "MUSIC"], capture_output=True, text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        path = ""
    return (Path(path) if path and path != str(Path.home()) else Path.home() / "Music") / "wd-radio"

def track_key(track):
    return track.get("file") or track.get("url") or track.get("search", "")

def track_label(track):
    return track["title"] + (f" — {track['subtitle']}" if track.get("subtitle") else "")

# a free name in a folder: "name.ext", else "name (1).ext", "name (2).ext"... (like the copies of a file manager)
def free_name(folder, name):
    stem, suffix = (Path(name).stem, Path(name).suffix) if not (folder / name).is_dir() else (name, "")
    target = folder / name
    count = 1
    while target.exists():
        target = folder / f"{stem} ({count}){suffix}"
        count += 1
    return target

def write_online(path, data):
    lines = [f"# {data.get('name', 'Radio')}: the online tracks", "",
             "One track per line: `- Title — Subtitle | YouTube link or search`. The .mp3 files of this folder are",
             "played too; anything else put in this folder goes to ignored/. Delete this file: it comes back with the",
             "tracks of the style.", ""]
    for track in data["tracks"]:
        lines.append(f"- {track_label(track)} | {track.get('url') or track.get('search', '')}")
    path.write_text("\n".join(lines) + "\n")

def read_online(path):
    tracks = []
    for line in path.read_text(errors="replace").splitlines():
        match = re.match(r"^\s*[-*]\s+(.+?)\s*\|\s*(\S.*?)\s*$", line)
        if match:
            title, _, subtitle = match.group(1).partition(" — ")
            target = match.group(2)
            tracks.append({"title": title, "subtitle": subtitle,
                           **({"url": target} if target.startswith(("http://", "https://")) else {"search": target})})
    return tracks

# The folder of a radio, kept clean: online.md (made again from radio.json when deleted), the .mp3 files, ignored/;
# anything else goes to ignored/ once it is not being written anymore (a download, a copy), never deleted
def radio_folder(name, data):
    folder = music_dir() / name
    folder.mkdir(parents=True, exist_ok=True)
    if not (folder / ONLINE_FILE).exists():
        write_online(folder / ONLINE_FILE, data)
    for entry in folder.iterdir():
        if entry.name in (ONLINE_FILE, IGNORED_DIR) or (entry.is_file() and entry.suffix.lower() == ".mp3"):
            continue
        try:
            if time.time() - entry.stat().st_mtime < 5:
                continue
            (folder / IGNORED_DIR).mkdir(exist_ok=True)
            shutil.move(str(entry), str(free_name(folder / IGNORED_DIR, entry.name)))
        except OSError:
            continue
    return folder

# The tracks of a radio: the online ones (online.md), then the .mp3 files of its folder; each one says whether it is
# kept offline (radio.json, or the user's choice: true or the mp3 it was saved to), downloaded (cached) or being
# downloaded; shown: the small radio of the styles without their own (wd-style radio show / hide)
def station(name):
    data = read_json(DATA_DIR / "styles" / name / "radio.json", None)
    if not data:
        return None
    data["station"] = name
    folder = radio_folder(name, data)
    offline = {track_key(track) for track in data["tracks"] if track.get("offline")}
    choices = read_json(USER_RADIO_DIR / "offline.json", {}).get(name, {})
    saved = {value for value in choices.values() if isinstance(value, str)}
    data["tracks"] = read_online(folder / ONLINE_FILE)
    data["online"] = len(data["tracks"])
    data["folder"] = str(folder)
    for file in sorted(folder.iterdir()):
        if file.is_file() and file.suffix.lower() == ".mp3" and str(file) not in saved:
            title, _, subtitle = file.stem.partition(" — ")
            data["tracks"].append({"title": title, "subtitle": subtitle, "file": str(file)})
    for track in data["tracks"]:
        key = track["key"] = track_key(track)
        choice = choices.get(key, key in offline)
        track["offline"] = bool(track.get("file")) or bool(choice)
        track["saved"] = choice if isinstance(choice, str) else ""
        track["cached"] = bool(cached(track))
        track["downloading"] = key in DOWNLOADING
    data["shown"] = read_json(USER_RADIO_DIR / "shown.json", {}).get(name, not data.get("hidden", False))
    # media of the page (the Miku beam, the Ado stage): the local copy, nothing until it is made
    data["media"] = {key: (media_file(name, key).as_uri() if media_file(name, key) else None)
                     for key in data.get("media", {})}
    return data

def media_file(name, key):
    files = sorted((CACHE_DIR / "media" / name).glob(f"{key}.webm"))
    return files[0] if files else None

# A media of a page: the video downloaded once, its parts (sections, seconds) cut and joined in one WebM (VP9 + Opus:
# decoded by WebKit with the free GStreamer plugins), the download deleted
def cache_media(name, key, spec):
    folder = CACHE_DIR / "media" / name
    work = folder / f".{key}"
    video = spec.get("video", False)
    audio = spec.get("audio", True)
    height = spec.get("height", 720)
    work.mkdir(parents=True, exist_ok=True)
    subprocess.run(["yt-dlp", "-q", "--no-warnings", "--no-playlist", "--merge-output-format", "mkv",
                    "-f", f"bv*[height<={height}]+ba/b[height<={height}]" if video else "bestaudio",
                    "-o", str(work / "source.%(ext)s"), spec["url"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sources = [f for f in work.glob("source.*") if f.suffix not in (".part", ".ytdl")]
    if sources and shutil.which("ffmpeg"):
        chains = []
        labels = ""
        sections = spec.get("sections", [[0, 1e9]])
        for i, (start, end) in enumerate(sections):
            if video:
                chains.append(f"[0:v]trim=start={start}:end={end},setpts=PTS-STARTPTS,scale=-2:{height},"
                              f"fps={spec.get('fps', 30)}[v{i}]")
                labels += f"[v{i}]"
            if audio:
                chains.append(f"[0:a]atrim=start={start}:end={end},asetpts=PTS-STARTPTS[a{i}]")
                labels += f"[a{i}]"
        chains.append(f"{labels}concat=n={len(sections)}:v={int(video)}:a={int(audio)}{'[v]' if video else ''}"
                      f"{'[a]' if audio else ''}")
        command = ["ffmpeg", "-v", "error", "-y", "-i", str(sources[0]), "-filter_complex", ";".join(chains)]
        if video:
            command += ["-map", "[v]", "-c:v", "libvpx-vp9", "-deadline", "realtime", "-cpu-used", "8", "-row-mt", "1",
                        "-b:v", spec.get("bitrate", "2M")]
        if audio:
            command += ["-map", "[a]", "-c:a", "libopus", "-b:a", "128k"]
        if subprocess.run(command + [str(work / "out.webm")], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0:
            (work / "out.webm").rename(folder / f"{key}.webm")
    shutil.rmtree(work, ignore_errors=True)

# The offline copy of a track: the file the user saved it to, else ~/.local/share/wd-radio/<hash of its url or
# search>/<title> — <subtitle>.<ext>
def track_folder(track):
    return CACHE_DIR / hashlib.sha1((track.get("url") or track.get("search", "")).encode()).hexdigest()[:12]

def cached(track):
    for path in (track.get("file"), track.get("saved")):
        if path:
            return Path(path) if Path(path).is_file() else None
    folder = track_folder(track)
    files = sorted(f for f in folder.glob("*.*") if f.suffix not in (".part", ".ytdl")) if folder.is_dir() else []
    return files[0] if files else None

# yt-dlp: the audio of a track into <target>.<ext> (its offline copy by default), or into the mp3 <target> (made in a
# work folder first: the folder of the radio never sees a part of a download); the file it made
def download(track, target=None, mp3=False):
    source = track.get("url") or f"ytsearch1:{track['search']}"
    if mp3:
        work = CACHE_DIR / ".saving" / hashlib.sha1(track_key(track).encode()).hexdigest()[:12]
        work.mkdir(parents=True, exist_ok=True)
        subprocess.run(["yt-dlp", "-q", "--no-warnings", "--no-playlist", "-x", "--audio-format", "mp3", "--audio-quality",
                        "0", "-o", str(work / "audio.%(ext)s"), source], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        made = work / "audio.mp3"
        result = shutil.move(str(made), str(target)) if made.is_file() else None
        shutil.rmtree(work, ignore_errors=True)
        return Path(result) if result else None
    target = Path(target) if target else track_folder(track) / track_label(track).replace("/", " ")
    subprocess.run(["yt-dlp", "-q", "--no-warnings", "--no-playlist", "-f", "bestaudio[ext=webm]/bestaudio",
                    "-o", f"{target}.%(ext)s", source], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    files = [f for f in target.parent.glob(f"{glob.escape(target.name)}.*") if f.suffix not in (".part", ".ytdl")]
    return files[0] if files else None

# Keep a track offline or not (the user's choice, offline.json: true or the file it was saved to); not offline: the
# copy made here is deleted (a file the user saved stays)
def set_offline(name, track, keep):
    choices = read_json(USER_RADIO_DIR / "offline.json", {})
    choices.setdefault(name, {})[track_key(track)] = keep
    USER_RADIO_DIR.mkdir(parents=True, exist_ok=True)
    (USER_RADIO_DIR / "offline.json").write_text(json.dumps(choices, ensure_ascii=False, indent=4) + "\n")
    if not keep and not track.get("file") and not track.get("saved"):
        shutil.rmtree(track_folder(track), ignore_errors=True)

# Download the offline tracks and the media of every installed style that are missing (one run at a time)
def cache_tracks():
    if not shutil.which("yt-dlp"):
        return
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    # the sounds of an older version (now media)
    shutil.rmtree(CACHE_DIR / "sounds", ignore_errors=True)
    with open(CACHE_DIR / ".lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
        for radio in sorted((DATA_DIR / "styles").glob("*/radio.json")):
            name = radio.parent.name
            for key, spec in read_json(radio, {}).get("media", {}).items():
                if not media_file(name, key):
                    cache_media(name, key, spec)
            for track in station(name)["tracks"]:
                if track["offline"] and not track["cached"]:
                    download(track)

# wd-style radio: the tracks of a radio from a terminal (the running wallpapers see the changes by themselves)
def radio_cli(args):
    command = args[0] if args else ""
    name = args[1] if len(args) > 1 else (DATA_DIR / "current").read_text().strip()
    data = station(name)
    if command in ("show", "hide", "toggle") and data is not None:
        shown = read_json(USER_RADIO_DIR / "shown.json", {})
        shown[name] = not data["shown"] if command == "toggle" else command == "show"
        USER_RADIO_DIR.mkdir(parents=True, exist_ok=True)
        (USER_RADIO_DIR / "shown.json").write_text(json.dumps(shown, ensure_ascii=False, indent=4) + "\n")
        print(f"the radio of {name}: {'shown' if shown[name] else 'hidden'}")
        return 0
    if command not in ("list", "add", "remove", "offline", "folder") or data is None:
        print("wd-style radio list [style] | add <style> <url|mp3|search> [title [subtitle]] | remove <style> <index>\n"
              "               | offline <style> <index|all> [on|off] | folder <style> | show | hide | toggle [style]"
              "   (styles with a radio: "
              + ", ".join(sorted(f.parent.name for f in (DATA_DIR / "styles").glob("*/radio.json"))) + ")", file=sys.stderr)
        return 1
    folder = Path(data["folder"])
    if command == "list":
        for index, track in enumerate(data["tracks"]):
            source = "mp3" if track.get("file") else ("url" if track.get("url") else "search")
            state = "offline" if track["cached"] else ("offline, not downloaded yet" if track["offline"] else "online")
            print(f"{index:3}  {track_label(track)}  [{source}, {state}]")
    elif command == "folder":
        print(f"{folder}  (its .mp3 files and {ONLINE_FILE}: the tracks; anything else goes to {IGNORED_DIR}/)")
    elif command == "add":
        if len(args) < 3:
            return radio_cli([])
        target = args[2]
        if Path(target).expanduser().is_file():
            if Path(target).suffix.lower() != ".mp3":
                print("only .mp3 files are tracks", file=sys.stderr)
                return 1
            copy = free_name(folder, Path(target).name)
            shutil.copy2(Path(target).expanduser(), copy)
            print(f"added: {copy.name}")
            return 0
        title = args[3] if len(args) > 3 else target
        if target.startswith(("http://", "https://")) and len(args) <= 3 and shutil.which("yt-dlp"):
            title = subprocess.run(["yt-dlp", "--no-warnings", "--no-playlist", "--print", "title", target],
                                   capture_output=True, text=True).stdout.strip() or target
        track = {"title": title, "subtitle": args[4] if len(args) > 4 else ""}
        with open(folder / ONLINE_FILE, "a") as online:
            online.write(f"- {track_label(track)} | {target}\n")
        print(f"added: {track_label(track)}")
    elif command == "remove":
        index = int(args[2]) if len(args) > 2 and args[2].isdigit() else -1
        if not 0 <= index < len(data["tracks"]):
            print("wd-style radio list: the index of the track", file=sys.stderr)
            return 1
        track = data["tracks"][index]
        if track.get("file"):
            (folder / IGNORED_DIR).mkdir(exist_ok=True)
            shutil.move(track["file"], str(free_name(folder / IGNORED_DIR, Path(track["file"]).name)))
        else:
            lines = (folder / ONLINE_FILE).read_text().splitlines()
            position = -1
            for number, line in enumerate(lines):
                if re.match(r"^\s*[-*]\s+(.+?)\s*\|\s*(\S.*?)\s*$", line):
                    position += 1
                    if position == index:
                        del lines[number]
                        break
            (folder / ONLINE_FILE).write_text("\n".join(lines) + "\n")
        print(f"removed: {track_label(track)}")
    else:
        keep = (args[3] if len(args) > 3 else "on") != "off"
        indexes = range(len(data["tracks"])) if len(args) > 2 and args[2] == "all" else \
            [int(args[2])] if len(args) > 2 and args[2].isdigit() and int(args[2]) < len(data["tracks"]) else []
        for index in indexes:
            track = data["tracks"][index]
            if track.get("file"):
                continue
            set_offline(name, track, keep)
            if keep and not cached(track) and shutil.which("yt-dlp"):
                print(f"downloading {track_label(track)}...")
                download(track)
            print(f"{track_label(track)}: {'offline' if keep and cached(track) else 'online'}")
    return 0

# The list given to mpv: (key, source, title); the offline copy when there is one (starts at once, no network, its
# title for the bar), else the link, else a YouTube search (its own title)
def playlist(data):
    entries = []
    for track in data["tracks"]:
        local = cached(track)
        if local or track.get("url"):
            entries.append((track["key"], str(local or track["url"]), track_label(track)))
        else:
            entries.append((track["key"], f"ytdl://ytsearch1:{track['search']}", ""))
    return entries

class Radio:
    """mpv playing the tracks of a station (radio.json: offline copies first, else YouTube searches through yt-dlp),
    driven over its IPC socket; the requests run outside of the GTK loop so the wallpaper never freezes"""

    def __init__(self, publish, refresh, tell):
        self.publish = publish
        self.refresh = refresh
        # a line of JavaScript for the pages (the start of a sound)
        self.tell = tell
        # the sound of a page playing (the Miku beam)
        self.effect = None
        self.process = None
        self.station = ""
        # one socket per wallpaper: another session keeps the control of its own radio
        self.socket = RUNTIME_DIR / f"wd-radio-{os.getpid()}.sock"
        # the list mpv plays (key, source, title), changed live with the folder of the radio
        self.entries = []
        # the tracks mpv could not load lately (no network, a video gone): their key, when
        self.errors = {}
        self.state = {"available": self.available(), "playing": False, "paused": False, "title": "", "index": 0,
                      "station": "", "key": "", "loop": bool(read_json(USER_RADIO_DIR / "player.json", {}).get("loop"))}

    @staticmethod
    def available():
        return bool(shutil.which("mpv") and shutil.which("yt-dlp"))

    # Radios of this session left by another wallpaper (killed, restarted): stopped, never two musics at once
    def stop_others(self):
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        mine = self.process.pid if self.running() else 0
        for pid in filter(str.isdigit, os.listdir("/proc")):
            try:
                command = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
                environ = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
            except OSError:
                continue
            if (int(pid) != mine and command and command[0].endswith(b"mpv")
                    and any(arg.startswith(b"--title=wd-radio") for arg in command)
                    and f"HYPRLAND_INSTANCE_SIGNATURE={signature}".encode() in environ):
                os.kill(int(pid), signal.SIGTERM)

    def running(self):
        return self.process is not None and self.process.poll() is None

    # One request to mpv (the radio, or the one at <path>), its answer (None when mpv doesn't answer)
    def command(self, *args, path=None):
        try:
            with socket.socket(socket.AF_UNIX) as client:
                client.settimeout(0.4)
                client.connect(str(path or self.socket))
                client.sendall((json.dumps({"command": list(args), "request_id": 1}) + "\n").encode())
                data = b""
                while True:
                    chunk = client.recv(4096)
                    if not chunk:
                        return None
                    data += chunk
                    for line in data.split(b"\n"):
                        if b'"request_id"' in line:
                            return json.loads(line).get("data")
        except (OSError, ValueError):
            return None

    def handle(self, message):
        threading.Thread(target=self.act, args=(message,), daemon=True).start()

    def act(self, message):
        action = message.get("action")
        if not shutil.which("mpv"):
            notify("Radio", "Needs mpv (and yt-dlp for the online tracks): ./install.sh installs them")
        elif action == "play":
            self.play(message.get("station", ""), int(message.get("index", 0)))
        elif action == "toggle" and self.running():
            self.command("cycle", "pause")
        elif action in ("next", "prev") and self.running():
            self.command("playlist-next" if action == "next" else "playlist-prev", "force")
        elif action == "stop":
            self.stop()
        elif action == "loop":
            # the loop is a setting: it can be changed while nothing plays, the next track follows it
            self.state["loop"] = not self.state["loop"]
            USER_RADIO_DIR.mkdir(parents=True, exist_ok=True)
            (USER_RADIO_DIR / "player.json").write_text(json.dumps({"loop": self.state["loop"]}) + "\n")
            if self.running():
                self.command("set_property", "loop-file", "inf" if self.state["loop"] else "no")
        elif action == "offline":
            self.keep(message.get("station", ""), int(message.get("index", 0)))
        elif action == "sound":
            self.sound(message.get("station", ""), message.get("key", ""))
        elif action == "folder":
            data = station(message.get("station", ""))
            if data:
                subprocess.Popen([str(Path.home() / ".local/bin/wd-style"), "files", data["folder"]],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        self.update()

    def play(self, name, index):
        data = station(name)
        if not data:
            return
        key = data["tracks"][index]["key"] if 0 <= index < len(data["tracks"]) else ""
        keys = [entry[0] for entry in self.entries]
        if self.running() and self.station == name and key in keys:
            self.command("set_property", "playlist-pos", keys.index(key))
            self.command("set_property", "pause", False)
            return
        self.stop()
        self.stop_others()
        self.entries = playlist(data)
        self.station = name
        arguments = []
        for _, source, title in self.entries:
            arguments += ["--{", f"--force-media-title={title}", source, "--}"] if title else [source]
        # the next track is fetched while this one plays
        self.process = subprocess.Popen(
            ["mpv", "--no-video", "--no-terminal", "--idle=no", f"--input-ipc-server={self.socket}",
             "--ytdl-format=bestaudio/best", "--loop-playlist=inf", f"--playlist-start={max(0, index)}", "--volume=70",
             f"--loop-file={'inf' if self.state['loop'] else 'no'}", "--prefetch-playlist=yes",
             f"--title=wd-radio {name}", *shlex.split(os.environ.get("WD_RADIO_ARGS", "")), *arguments],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        threading.Thread(target=self.watch, args=(self.process,), daemon=True).start()
        threading.Thread(target=self.listen, args=(self.process,), daemon=True).start()

    # The events of this mpv: a track it could not load is kept in errors (shown red by the pages) for a while
    def listen(self, process):
        for _ in range(50):
            if process.poll() is not None:
                return
            client = socket.socket(socket.AF_UNIX)
            try:
                client.connect(str(self.socket))
                break
            except OSError:
                client.close()
                time.sleep(0.1)
        else:
            return
        with client:
            buffer = b""
            while process.poll() is None and (chunk := client.recv(4096)):
                *lines, buffer = (buffer + chunk).split(b"\n")
                for line in lines:
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    if event.get("event") == "end-file" and event.get("reason") == "error":
                        self.failed(event.get("playlist_entry_id"))

    def failed(self, entry):
        files = {item.get("id"): item.get("filename") for item in self.command("get_property", "playlist") or []}
        for key, source, _ in self.entries:
            if source == files.get(entry):
                self.errors[key] = time.time()

    # The folder of the playing radio changed: the tracks gone leave the list, the new ones join its end (the music
    # goes on)
    def sync(self, data):
        if not self.running() or data["station"] != self.station:
            return
        entries = playlist(data)
        keys = [entry[0] for entry in self.entries]
        wanted = {entry[0] for entry in entries}
        for position in reversed(range(len(keys))):
            if keys[position] not in wanted:
                self.command("playlist-remove", position)
                del self.entries[position]
                del keys[position]
        for entry in entries:
            if entry[0] not in keys:
                title = entry[2]
                self.command("loadfile", entry[1], "append", -1,
                             f"force-media-title=%{len(title.encode())}%{title}" if title else "")
                self.entries.append(entry)
                keys.append(entry[0])
        self.update()

    def stop(self):
        if self.running():
            self.process.terminate()
        self.process = None

    # A sound of a page (the Miku beam): mpv plays it like the radio (WebKit refused to play it at times), the radio
    # paused meanwhile; the pages learn where it is once it plays (their clock)
    def sound(self, name, key):
        file = media_file(name, key)
        if not file or not shutil.which("mpv") or (self.effect and self.effect.poll() is None):
            self.tell(f"window.wdSoundStarted && wdSoundStarted({json.dumps(key)}, -1)")
            return
        resume = self.running() and self.command("get_property", "pause") is False
        if resume:
            self.command("set_property", "pause", True)
        path = RUNTIME_DIR / f"wd-sound-{os.getpid()}.sock"
        self.effect = subprocess.Popen(
            ["mpv", "--no-video", "--no-terminal", "--idle=no", f"--input-ipc-server={path}", f"--title=wd-radio {key}",
             "--volume=80", *shlex.split(os.environ.get("WD_RADIO_ARGS", "")), str(file)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        position = None
        for _ in range(250):
            position = self.command("get_property", "time-pos", path=path)
            if (position is not None and position > 0) or self.effect.poll() is not None:
                break
            time.sleep(0.02)
        self.tell(f"window.wdSoundStarted && wdSoundStarted({json.dumps(key)}, {position or 0})")
        self.effect.wait()
        if resume and self.running():
            self.command("set_property", "pause", False)

    # The download button of the player: the track saved as an mp3 where the user says (a dialog), then played from it
    def keep(self, name, index):
        data = station(name)
        if not data or not 0 <= index < len(data["tracks"]):
            return
        track = data["tracks"][index]
        if not track["downloading"] and (track.get("file") or shutil.which("yt-dlp")):
            GLib.idle_add(self.ask_save, name, track)

    def dialog(self, title, action, button):
        dialog = Gtk.FileChooserDialog(title=title, action=action)
        dialog.add_buttons("_Cancel", Gtk.ResponseType.CANCEL, button, Gtk.ResponseType.ACCEPT)
        dialog.set_keep_above(True)
        return dialog

    def ask_save(self, name, track):
        dialog = self.dialog(f"Save {track_label(track)}", Gtk.FileChooserAction.SAVE, "_Save")
        folder = music_dir() / name
        folder.mkdir(parents=True, exist_ok=True)
        dialog.set_do_overwrite_confirmation(True)
        dialog.set_current_folder(str(folder))
        dialog.set_current_name(track_label(track).replace("/", " ") + ".mp3")
        dialog.connect("response", self.saving, name, track)
        dialog.show()
        return False

    def saving(self, dialog, response, name, track):
        path = dialog.get_filename() if response == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        if path:
            threading.Thread(target=self.save, args=(name, track, Path(path).with_suffix(".mp3")), daemon=True).start()

    # the track saved as an mp3 where the user said (a copy for an mp3 of the folder), then played from it (offline)
    def save(self, name, track, path):
        if track.get("file"):
            shutil.copy2(track["file"], path)
            self.refresh()
            return
        DOWNLOADING.add(track["key"])
        self.refresh()
        file = download(track, path, mp3=True)
        DOWNLOADING.discard(track["key"])
        if file:
            set_offline(name, track, str(file))
        self.refresh()

    # State for the pages every second while this mpv plays
    def watch(self, process):
        while process.poll() is None:
            self.update()
            time.sleep(1)
        self.update()

    def update(self):
        if self.running():
            position = self.command("get_property", "playlist-pos") or 0
            paused = bool(self.command("get_property", "pause"))
            moment = self.command("get_property", "time-pos")
            key = self.entries[position][0] if position < len(self.entries) else ""
            # playing again: no more an error
            if moment:
                self.errors.pop(key, None)
            self.state.update(playing=True, station=self.station, paused=paused, index=position, key=key,
                              title=self.command("get_property", "media-title") or "", time=moment or 0,
                              duration=self.command("get_property", "duration") or 0,
                              loading=not paused and (moment is None
                                                      or bool(self.command("get_property", "paused-for-cache"))))
        else:
            self.state.update(playing=False, paused=False, title="", key="", time=0, duration=0, loading=False)
        # the errors of the last 10 minutes, the network (an online track can't play without it)
        now = time.time()
        self.errors = {key: at for key, at in self.errors.items() if now - at < 600}
        self.state.update(failed=list(self.errors), network=Gio.NetworkMonitor.get_default().get_network_available())
        GLib.idle_add(self.publish, dict(self.state))

# =========================
# Power
# =========================
class Watcher:
    """How much of each monitor shows the wallpaper, from the Hyprland events: 24 frames a second on an empty workspace,
    10 under a few windows, paused when the windows cover it (tiled, fullscreen, maximized)"""

    EVENTS = {b"workspace", b"workspacev2", b"focusedmon", b"openwindow", b"closewindow", b"movewindow", b"movewindowv2",
              b"fullscreen", b"changefloatingmode", b"activespecial", b"minimized", b"monitoradded", b"monitorremoved"}

    def __init__(self, apply):
        self.apply = apply
        self.timer = None
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if signature and shutil.which("hyprctl"):
            self.events = RUNTIME_DIR / "hypr" / signature / ".socket2.sock"
            threading.Thread(target=self.listen, daemon=True).start()

    def listen(self):
        self.update()
        try:
            with socket.socket(socket.AF_UNIX) as client:
                client.connect(str(self.events))
                buffer = b""
                while chunk := client.recv(4096):
                    *lines, buffer = (buffer + chunk).split(b"\n")
                    if any(line.split(b">>")[0] in self.EVENTS for line in lines):
                        self.later()
        except OSError:
            pass

    # a burst of events gives one update
    def later(self):
        if self.timer:
            self.timer.cancel()
        self.timer = threading.Timer(0.15, self.update)
        self.timer.daemon = True
        self.timer.start()

    def update(self):
        try:
            monitors = json.loads(subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True).stdout)
            clients = json.loads(subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True).stdout)
        except (OSError, ValueError):
            return
        frames = {}
        for monitor in monitors:
            shown = {monitor["activeWorkspace"]["id"], monitor.get("specialWorkspace", {}).get("id", 0)}
            windows = [c for c in clients if c["workspace"]["id"] in shown and c.get("mapped", True)
                       and not c.get("hidden", False)]
            width = monitor["width"] / monitor.get("scale", 1)
            height = monitor["height"] / monitor.get("scale", 1)
            area = sum(max(0, min(c["at"][0] + c["size"][0], monitor["x"] + width) - max(c["at"][0], monitor["x"]))
                       * max(0, min(c["at"][1] + c["size"][1], monitor["y"] + height) - max(c["at"][1], monitor["y"]))
                       for c in windows)
            covered = any(c.get("fullscreen", 0) for c in windows) or area >= 0.8 * width * height
            frames[(monitor["x"], monitor["y"])] = 0 if covered else (10 if windows else 24)
        GLib.idle_add(self.apply, frames)

# =========================
# Lock
# =========================
def lock_socket():
    return RUNTIME_DIR / f"wd-lock-{os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', 'session')}.sock"

# wd-wallpaper --lock: asks the wallpaper of this session to lock it, waits for the unlock
def lock_cli():
    try:
        client = socket.socket(socket.AF_UNIX)
        client.connect(str(lock_socket()))
        client.sendall(b"lock\n")
    except OSError:
        return 1
    answer = b""
    with client:
        while chunk := client.recv(64):
            answer += chunk
            if b"unlocked" in answer:
                return 0
            if b"failed" in answer and b"locked" not in answer.replace(b"unlocked", b""):
                return 1
    # the wallpaper died, or gave the lock up while locked: the session stays locked until hyprlock takes it
    return 2 if b"locked" in answer else 1

# The password through PAM the way hyprlock asks it: its service, the auth stack only (pam_authenticate); never the
# account or the credentials stacks (the hyprlock service has none: a right password would fail there). Run in a process
# of its own for each try (wd-wallpaper --pam): a module like pam_usb loads libudisks2, whose types can't be registered
# twice in one process (a second try would never end)
class PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]

class PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_void_p), ("resp_retcode", ctypes.c_int)]

PAM_CONVERSATION = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(PamMessage)),
                                    ctypes.POINTER(ctypes.POINTER(PamResponse)), ctypes.c_void_p)

class PamConv(ctypes.Structure):
    _fields_ = [("conv", PAM_CONVERSATION), ("appdata_ptr", ctypes.c_void_p)]

# libpam with its symbols global: modules like pam_usb are not linked to it and look for pam_get_item... in the
# program (loaded local, PAM can't load them and refuses even the right password)
def pam_library():
    name = ctypes.util.find_library("pam")
    return ctypes.CDLL(name, mode=ctypes.RTLD_GLOBAL) if name else None

def pam_check(password, service="hyprlock"):
    libpam = pam_library()
    libc = ctypes.CDLL(ctypes.util.find_library("c"))
    libc.calloc.restype = ctypes.c_void_p
    libc.calloc.argtypes = [ctypes.c_size_t, ctypes.c_size_t]
    libc.strdup.restype = ctypes.c_void_p
    libc.strdup.argtypes = [ctypes.c_char_p]
    secret = password.encode()

    # the answers PAM frees itself: the password to the prompts that hide what is typed, nothing to the others
    def conversation(count, messages, responses, _):
        answers = libc.calloc(count, ctypes.sizeof(PamResponse))
        if not answers:
            return 5
        responses[0] = ctypes.cast(answers, ctypes.POINTER(PamResponse))
        for i in range(count):
            if messages[i].contents.msg_style == 1:
                responses[0][i].resp = libc.strdup(secret)
        return 0

    conv = PamConv(PAM_CONVERSATION(conversation), None)
    handle = ctypes.c_void_p()
    if libpam.pam_start(service.encode(), pwd.getpwuid(os.getuid()).pw_name.encode(), ctypes.byref(conv),
                        ctypes.byref(handle)) != 0:
        return False
    result = libpam.pam_authenticate(handle, 0)
    libpam.pam_end(handle, result)
    return result == 0

# The facts the locks show (the shell of Terminal: fastfetch, the profiles, its image; System: the face of the user)
def lock_facts():
    user = pwd.getpwuid(os.getuid()).pw_name
    info = {"user": user, "host": socket.gethostname().split(".")[0], "facts": {}, "profiles": [], "style": "",
            "logo": "", "face": ""}
    try:
        result = subprocess.run(["fastfetch", "--format", "json", "--structure",
                                 "OS:Host:Kernel:Uptime:Packages:CPU:GPU:Memory:Disk:Battery"],
                                capture_output=True, text=True, timeout=8)
        info["facts"] = {item["type"]: item.get("result") for item in json.loads(result.stdout)}
    except (OSError, ValueError, subprocess.TimeoutExpired, KeyError, TypeError):
        pass
    for folder in sorted((DATA_DIR / "styles").glob("*/style.env")):
        name = re.search(r'^NAME="(.*)"$', folder.read_text(), re.M)
        info["profiles"].append({"id": folder.parent.name, "name": name.group(1) if name else folder.parent.name})
    try:
        info["style"] = (DATA_DIR / "current").read_text().strip()
    except OSError:
        pass
    config = Path.home() / ".config" / "fastfetch" / "config.jsonc"
    source = re.search(r'"source":\s*"([^"]+\.(?:png|jpe?g|webp))"', config.read_text()) if config.exists() else None
    for key, path in (("logo", Path(os.path.expanduser(source.group(1))) if source else None),
                      ("face", Path.home() / ".face"), ("face", Path("/var/lib/AccountsService/icons") / user)):
        if path and not info[key] and path.is_file() and os.access(path, os.R_OK):
            info[key] = path.as_uri()
    info["logo"] = info["logo"] or info["face"]
    return info

# =========================
# Wallpaper
# =========================
class Wallpaper:
    def __init__(self, page, demo):
        self.page = page
        self.demo = demo
        self.windows = []
        self.cava = None
        self.radio = Radio(self.publish, self.refresh_stations, lambda script: GLib.idle_add(self.run_js, script))
        # the folders of the radios (edited by hand, by wd-style radio, by the player) reach the pages by themselves
        self.radio_tracks = {}
        GLib.timeout_add_seconds(3, self.watch_radio)
        threading.Thread(target=self.radio.stop_others, daemon=True).start()
        self.frames = {}
        # the lock of the session (gtk-session-lock): its surfaces holding the pages, the clients waiting for the unlock
        self.locker = None
        self.covers = []
        self.lock_clients = []
        self.checking = False
        self.failures = 0
        self.facts = {}
        self.later = set()
        display = Gdk.Display.get_default()
        display.connect("monitor-added", lambda *_: self.build())
        display.connect("monitor-removed", lambda *_: self.build())
        self.build()
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, self.reload)
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.quit)
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.quit)
        if not demo:
            threading.Thread(target=self.listen, daemon=True).start()
        Watcher(self.power)
        threading.Thread(target=self.cache, daemon=True).start()
        if not demo:
            threading.Thread(target=self.serve, daemon=True).start()

    # One background surface per monitor (after the unlock while locked: the pages hold the lock)
    def build(self):
        if self.locker:
            self.later.add("build")
            return False
        for window in self.windows:
            window.destroy()
        self.windows = []
        display = Gdk.Display.get_default()
        for index in range(display.get_n_monitors()):
            self.windows.append(self.window(display.get_monitor(index)))
        return False

    def window(self, monitor):
        window = Gtk.Window()
        GtkLayerShell.init_for_window(window)
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.BACKGROUND)
        GtkLayerShell.set_namespace(window, "wd-wallpaper")
        GtkLayerShell.set_monitor(window, monitor)
        GtkLayerShell.set_exclusive_zone(window, -1)
        GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.NONE)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT,
                     GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(window, edge, True)

        # transparent: the still wallpaper (swaybg) or the previous page stays visible until the new page fades in
        visual = window.get_screen().get_rgba_visual()
        if visual:
            window.set_visual(visual)
        window.set_app_paintable(True)
        window.overlay = Gtk.Overlay()
        window.overlay.add(Gtk.Box())
        window.add(window.overlay)
        window.views = []
        window.monitor = monitor
        window.fps = 24
        window.connect("realize", lambda w: self.clickable(w, []))
        self.add_view(window)
        window.show_all()
        return window

    def add_view(self, window):
        view = self.make_view(window)
        window.overlay.add_overlay(view)
        window.views.append(view)
        view.show()

    def make_view(self, window):
        # the pages play their own media (the Miku beam, the Ado stage): no autoplay block, no gesture needed
        view = WebKit2.WebView(website_policies=WebKit2.WebsitePolicies(autoplay=WebKit2.AutoplayPolicy.ALLOW))
        manager = view.get_user_content_manager()
        manager.register_script_message_handler("wd")
        manager.connect("script-message-received::wd", self.message, view)
        settings = view.get_settings()
        settings.set_enable_webgl(True)
        settings.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)
        settings.set_allow_file_access_from_file_urls(True)
        settings.set_media_playback_requires_user_gesture(False)
        settings.set_enable_page_cache(False)
        view.set_background_color(Gdk.RGBA(0, 0, 0, 0))
        view.window = window
        view.rects = []
        view.station = Path(self.page).resolve().parent.name if self.page else (DATA_DIR / "current").read_text().strip()
        view.connect("load-changed", lambda v, event: event == WebKit2.LoadEvent.FINISHED and self.loaded(v))
        view.load_uri(page_uri(self.page, self.demo))
        return view

    # Only the rects of the page take the clicks: clickable <window> <[[x, y, w, h], ...]>
    def clickable(self, window, rects):
        if window.get_window():
            window.input_shape_combine_region(cairo.Region([cairo.RectangleInt(*rect) for rect in rects]))

    def message(self, manager, result, view):
        value = result.get_js_value() if hasattr(result, "get_js_value") else result
        try:
            data = json.loads(value.to_string())
        except ValueError:
            return
        # the pages of the lock: their own messages only
        if getattr(view, "locking", False) and data.get("type") in ("ready", "input", "radio"):
            return
        if data.get("type") == "ready":
            self.shown(view)
        elif data.get("type") == "input":
            view.rects = data.get("rects", [])
            if view.window.views and view.window.views[-1] is view:
                self.clickable(view.window, view.rects)
        elif data.get("type") == "radio":
            self.radio.handle(data)
        elif data.get("type") == "play":
            # a play of the page that WebKit refused for want of a user gesture: a script of this side counts as one
            view.evaluate_javascript("window.wdPlay && wdPlay()", -1, None, None, None, None, None)
        elif data.get("type") == "log":
            print(f"wd-wallpaper: {data.get('text')}", file=sys.stderr)
        elif data.get("type") == "lock-ready" and self.locker:
            view.lock_ready = True
        elif data.get("type") == "unlock" and self.locker:
            self.check(view, data.get("password", ""))
        elif data.get("type") == "lock-run" and self.locker:
            self.lock_run(data.get("command"), data.get("value", ""))

    # A page has faded in: the pages below it and the still wallpaper of this session go away
    def shown(self, view):
        window = view.window
        if view not in window.views:
            return
        # the old pages go, with their web process (a destroyed view kept it, ~250 MB at each change of style)
        for old in window.views[:window.views.index(view)]:
            old.get_user_content_manager().unregister_script_message_handler("wd")
            old.terminate_web_process()
            window.overlay.remove(old)
            old.destroy()
        window.views = window.views[window.views.index(view):]
        self.clickable(window, view.rects)
        view.evaluate_javascript(f"window.wdPower && wdPower({window.fps})", -1, None, None, None, None, None)
        threading.Thread(target=self.radio.update, daemon=True).start()
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        for pid in filter(str.isdigit, os.listdir("/proc")):
            try:
                comm = Path(f"/proc/{pid}/comm").read_text().strip()
                environ = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
            except OSError:
                continue
            if comm == "swaybg" and f"HYPRLAND_INSTANCE_SIGNATURE={signature}".encode() in environ:
                os.kill(int(pid), signal.SIGTERM)

    # A new page: the radio of another station stops (switching style never leaves a music playing behind)
    def loaded(self, view):
        if getattr(view, "locking", False):
            self.give_station(view)
            view.evaluate_javascript(f"window.wdPower && wdPower(24); window.wdRadio && wdRadio({json.dumps(self.radio.state)});"
                                     f" window.wdLock && wdLock(true, {json.dumps(self.facts)})", -1, None, None, None,
                                     None, None)
            return
        if self.radio.running() and self.radio.station != view.station:
            threading.Thread(target=self.radio.act, args=({"action": "stop"},), daemon=True).start()
        self.give_station(view)

    # The page gets the station of its style (radio.json + which tracks are offline) and the user's emotes
    def give_station(self, view):
        data = station(view.station)
        emotes = [f.as_uri() for f in sorted(EMOTES_DIR.glob("*"))
                  if f.suffix.lower() in (".png", ".gif", ".webp", ".jpg", ".jpeg", ".svg")] if EMOTES_DIR.is_dir() else []
        view.evaluate_javascript(f"window.wdStation && wdStation({json.dumps(data)}); "
                                 f"window.wdEmotes && wdEmotes({json.dumps(emotes)})", -1, None, None, None, None, None)

    # Missing offline tracks are fetched in the background, then the pages learn they are there
    def cache(self):
        cache_tracks()
        self.refresh_stations()

    def refresh_stations(self):
        GLib.idle_add(lambda: [self.give_station(view) for window in self.windows for view in window.views] and False)

    # Every 3 seconds: the folder of the radio of each page and of the one playing; a change goes to the pages and to
    # the playing list
    def watch_radio(self):
        names = {view.station for window in self.windows for view in window.views} | ({self.radio.station} - {""})
        threading.Thread(target=self.check_radios, args=(names,), daemon=True).start()
        return True

    def check_radios(self, names):
        for name in names:
            data = station(name)
            if not data:
                continue
            stamp = json.dumps([[t["key"], t["title"], t.get("subtitle", ""), t["offline"], t["cached"], t["downloading"]]
                                for t in data["tracks"]] + [data["shown"]])
            if name in self.radio_tracks and stamp != self.radio_tracks[name]:
                self.refresh_stations()
                self.radio.sync(data)
            self.radio_tracks[name] = stamp

    def publish(self, state):
        self.run_js(f"window.wdRadio && wdRadio({json.dumps(state)})")
        return False

    def run_js(self, script):
        for view in self.views():
            view.evaluate_javascript(script, -1, None, None, None, None, None)

    # the pages of the wallpaper, and of the lock while locked
    def views(self):
        return [view for window in self.windows for view in window.views] + [view for _, _, view in self.covers]

    # Frame rate of each monitor (Watcher): told to its pages when it changes; cava waits while nothing shows; locked:
    # the pages of the lock at full speed
    def power(self, frames):
        self.frames = frames
        if self.locker:
            return False
        for window in self.windows:
            geometry = window.monitor.get_geometry()
            fps = frames.get((geometry.x, geometry.y), 24)
            if fps != window.fps:
                window.fps = fps
                for view in window.views:
                    view.evaluate_javascript(f"window.wdPower && wdPower({fps})", -1, None, None, None, None, None)
        if self.cava and self.cava.poll() is None:
            self.cava.send_signal(signal.SIGSTOP if all(w.fps <= 0 for w in self.windows) else signal.SIGCONT)
        return False

    # New style: its page fades in over the current one (crossfade); after the unlock while locked
    def reload(self):
        if self.locker:
            self.later.add("reload")
            return True
        for window in self.windows:
            self.add_view(window)
        return True

    # =========================
    # Music
    # =========================
    def listen(self):
        if not shutil.which("cava"):
            return
        config = RUNTIME_DIR / "wd-cava-wallpaper.conf"
        config.write_text(CAVA_CONFIG)
        self.cava = subprocess.Popen(["cava", "-p", str(config)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                     text=True)
        for line in self.cava.stdout:
            levels = line.strip().rstrip(";")
            if levels:
                GLib.idle_add(self.push, levels)

    # the levels reach a page at its own frame rate (10 under windows, 24 on the desktop), never when it is paused
    def push(self, levels):
        now = time.monotonic()
        script = f"window.wdAudio && wdAudio([{levels.replace(';', ',')}])"
        for window in self.windows:
            if window.fps > 0 and now - getattr(window, "pushed", 0) >= 0.9 / window.fps:
                window.pushed = now
                for view in window.views:
                    view.evaluate_javascript(script, -1, None, None, None, None, None)
        for _, _, view in self.covers:
            if now - getattr(view, "pushed", 0) >= 0.9 / 24:
                view.pushed = now
                view.evaluate_javascript(script, -1, None, None, None, None, None)
        return False

    # =========================
    # Lock
    # =========================
    # Lock requests (wd-wallpaper --lock): the client waits on its socket for "locked", then "unlocked"
    def serve(self):
        path = lock_socket()
        path.unlink(missing_ok=True)
        server = socket.socket(socket.AF_UNIX)
        server.bind(str(path))
        server.listen(4)
        while True:
            client, _ = server.accept()
            try:
                client.settimeout(2)
                request = client.recv(64)
                client.settimeout(None)
            except OSError:
                client.close()
                continue
            if request.strip() == b"lock":
                GLib.idle_add(self.lock, client)
            else:
                client.close()

    def tell(self, clients, word):
        for client in clients:
            try:
                client.sendall(word + b"\n")
            except OSError:
                pass

    # Each monitor gets a lock surface with a live page of the style of its own (a WebView moved from the wallpaper
    # paints nothing there), which draws its lock; the pages of the wallpaper rest meanwhile; no PAM, no session lock or
    # no page: hyprlock locks instead
    def lock(self, client):
        if self.locker:
            self.lock_clients.append(client)
            self.tell([client], b"locked")
            return False
        if not (GtkSessionLock and GtkSessionLock.is_supported() and pam_library() and self.windows
                and all(window.views for window in self.windows)):
            self.tell([client], b"failed")
            client.close()
            return False
        self.lock_clients = [client]
        self.failures = 0
        self.locker = GtkSessionLock.prepare_lock()
        self.locker.lock_lock()
        self.covers = []
        self.facts = {}
        for window in self.windows:
            cover = Gtk.Window()
            self.locker.new_surface(cover, window.monitor)
            view = self.make_view(window)
            # no pointer on the lock (WebKit hides it only once the mouse moves)
            for widget in (cover, view):
                widget.connect("realize", lambda w: w.get_window().set_cursor(
                    Gdk.Cursor.new_for_display(w.get_display(), Gdk.CursorType.BLANK_CURSOR)))
            view.locking = True
            view.lock_ready = False
            cover.add(view)
            cover.show_all()
            view.grab_focus()
            self.covers.append((cover, window, view))
            window.fps = 0
            for rest in window.views:
                rest.evaluate_javascript("window.wdPower && wdPower(0)", -1, None, None, None, None, None)
        if self.cava and self.cava.poll() is None:
            self.cava.send_signal(signal.SIGCONT)
        self.tell(self.lock_clients, b"locked")
        threading.Thread(target=lambda: GLib.idle_add(self.lock_info, lock_facts()), daemon=True).start()
        GLib.timeout_add(8000, self.lock_check)
        return False

    def lock_info(self, info):
        self.facts = info
        for _, _, view in self.covers:
            view.evaluate_javascript(f"window.wdLockInfo && wdLockInfo({json.dumps(info)})", -1, None, None, None,
                                     None, None)
        return False

    # A page that doesn't draw its lock: the lock is given up without unlocking (the session stays locked), the client
    # hands it to hyprlock
    def lock_check(self):
        if self.locker and not all(view.lock_ready for _, _, view in self.covers):
            print("wd-wallpaper: a page did not draw its lock, hyprlock takes it", file=sys.stderr)
            self.release(unlock=False)
        return False

    # The password of the page, checked by PAM out of the GTK loop (its delay after a failure included)
    def check(self, view, password):
        if self.checking:
            return
        self.checking = True

        def run():
            try:
                ok = subprocess.run([sys.executable, str(Path(__file__).resolve()), "--pam"], input=password.encode(),
                                    capture_output=True, timeout=90).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ok = False
            GLib.idle_add(self.checked, view, ok)

        threading.Thread(target=run, daemon=True).start()

    def checked(self, view, ok):
        self.checking = False
        if not self.locker:
            return False
        view.evaluate_javascript(f"window.wdLockResult && wdLockResult({'true' if ok else 'false'})", -1, None, None,
                                 None, None, None)
        if ok:
            # the page says welcome back first
            GLib.timeout_add(450, lambda: self.release(unlock=True) and False)
            return False
        # three failures in a row: hyprlock takes the lock (the session stays locked), never a lock that can't open
        self.failures += 1
        if self.failures >= 3:
            print("wd-wallpaper: three failed passwords, hyprlock takes the lock", file=sys.stderr)
            GLib.timeout_add(1500, lambda: self.locker and self.release(unlock=False) and False)
        return False

    # The commands of the shell of the Terminal lock that act outside of the page
    def lock_run(self, command, value):
        if command == "switch" and value in {p.parent.name for p in (DATA_DIR / "styles").glob("*/style.env")}:
            subprocess.Popen([str(Path.home() / ".local" / "bin" / "wd-style"), "set", value],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        elif command in ("suspend", "reboot", "poweroff"):
            subprocess.Popen(["systemctl", command], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)

    # The pages of the lock go, with their web process, the wallpaper plays again; unlock: the session too (else it stays
    # locked for hyprlock)
    def release(self, unlock):
        for _, _, view in self.covers:
            view.get_user_content_manager().unregister_script_message_handler("wd")
            view.terminate_web_process()
        if unlock:
            self.locker.unlock_and_destroy()
        else:
            self.locker.destroy()
        Gdk.Display.get_default().sync()
        for cover, _, _ in self.covers:
            cover.destroy()
        self.locker = None
        self.covers = []
        self.tell(self.lock_clients, b"unlocked" if unlock else b"failed")
        for client in self.lock_clients:
            client.close()
        self.lock_clients = []
        for window in self.windows:
            window.fps = -1
        self.power(self.frames)
        for task in sorted(self.later):
            getattr(self, task)()
        self.later = set()
        return True

    def quit(self):
        if self.cava:
            self.cava.terminate()
        self.radio.stop()
        Gtk.main_quit()
        return False

# =========================
# Program
# =========================
def main():
    if "--cache" in sys.argv:
        cache_tracks()
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--radio":
        sys.exit(radio_cli(sys.argv[2:]))
    if "--lock" in sys.argv:
        sys.exit(lock_cli())
    if "--pam" in sys.argv:
        sys.exit(0 if pam_check(sys.stdin.buffer.read().decode(errors="surrogateescape")) else 1)
    args = [arg for arg in sys.argv[1:] if not arg.startswith("--")]
    load_gui()
    # the app id of the dialogs of the radio (a floating window rule of Hyprland)
    GLib.set_prgname("wd-wallpaper")
    # process name for pgrep / pkill (wd-style)
    ctypes.CDLL(None).prctl(15, b"wd-wallpaper", 0, 0, 0)
    Wallpaper(args[0] if args else None, "--demo" in sys.argv)
    Gtk.main()

if __name__ == "__main__":
    main()
