// wayland-desktop style: Terminal / better-tty - waybar (the lines marked wd-switcher are removed when a single style is installed)
{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "margin": "0 8 6 8",
    "spacing": 0,
    "modules-left": [
        "custom/overview",
        "custom/style", // wd-switcher
        "hyprland/workspaces"
    ],
    "modules-center": ["group/music"],
    "modules-right": ["cpu", "memory", "pulseaudio", "battery", "clock", "custom/host", "group/session"],
    "custom/style": { // wd-switcher-begin
        "exec": "~/.local/bin/wd-style current --label",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.local/bin/wd-style menu",
        "on-scroll-up": "~/.local/bin/wd-style next",
        "on-scroll-down": "~/.local/bin/wd-style prev",
        "tooltip-format": "Style: click to choose, scroll to switch"
    }, // wd-switcher-end
    "custom/overview": {
        "format": "{}",
        "on-click": "~/.local/bin/wd-style overview",
        "on-click-right": "~/.local/bin/wd-style apps",
        "tooltip-format": "Overview (Super) - right click: applications (Super+A)",
        "exec": "echo \"❯ $USER\"",
        "interval": "once"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        },
        "sort-by-number": true
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%A %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "on-scroll": 1,
            "format": {
                "today": "<span color='#c4a7e7'><b>{}</b></span>",
                "weekdays": "<span color='#908caa'>{}</span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },
    "group/music": {
        "orientation": "inherit",
        "modules": ["mpris", "custom/cava"]
    },
    "mpris": {
        "format": "  {dynamic}",
        "format-paused": "  {dynamic}",
        "format-stopped": "",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 34,
        "dynamic-separator": " · ",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "tooltip-format": "{title}\n{artist}  {album}\nclick: play / pause - right: next - middle: previous"
    },
    "custom/cava": {
        "exec": "~/.local/bin/wd-style cava",
        "format": "{}",
        "tooltip": false,
        "restart-interval": 30
    },
    "cpu": {
        "format": "cpu {usage}%",
        "interval": 2,
        "on-click": "~/.local/bin/wd-style monitor"
    },
    "memory": {
        "format": "mem {percentage}%",
        "interval": 5,
        "on-click": "~/.local/bin/wd-style monitor"
    },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "eth",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname}  {ipaddr}  {signalStrength}%",
        "on-click": "~/.local/bin/wd-style settings network"
    },
    "pulseaudio": {
        "format": "vol {volume}",
        "format-muted": "vol muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.local/bin/wd-style settings sound",
        "tooltip-format": "{desc}  {volume}%\nclick: mute - right: settings - scroll: volume"
    },
    "battery": {
        "format": "bat {capacity}%",
        "format-charging": "chg {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 25,
            "critical": 12
        },
        "on-click": "~/.local/bin/wd-style settings power"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip-format-activated": "Stay awake: on",
        "tooltip-format-deactivated": "Stay awake: off"
    },
    "tray": {
        "spacing": 8,
        "icon-size": 16
    },
    "group/session": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 450,
            "children-class": "session-child",
            "transition-left-to-right": false
        },
        "modules": ["custom/power", "custom/lock", "custom/suspend"]
    },
    "custom/power": {
        "format": "",
        "on-click": "~/.local/bin/wd-style power",
        "tooltip-format": "Power menu: lock, log out, suspend, reboot, shut down (Super+X)"
    },
    "custom/lock": {
        "format": "",
        "on-click": "hyprlock",
        "tooltip-format": "Lock (Super+L)"
    },
    "custom/suspend": {
        "format": "",
        "on-click": "systemctl suspend",
        "tooltip-format": "Suspend"
    },
    "custom/host": {
        "exec": "hostname",
        "interval": "once",
        "format": "{}"
    }
}
